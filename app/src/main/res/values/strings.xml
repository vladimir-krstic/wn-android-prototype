    <string name="share_diagnostic_logs">Share Diagnostic Logs</string>
    <string name="diagnostics_privacy">Analytics never include messages, media, contacts, profile details, or keys. Diagnostic logs obscure identifiers and are securely sent to White Noise for troubleshooting.</string>
